<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. Without one, a launcher has to fall back to the raw bitmap and draws its
  own white plate behind it, which is the white ring the old icon showed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- The mark and the wordmark, tinted by the system: only the alpha is read. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
