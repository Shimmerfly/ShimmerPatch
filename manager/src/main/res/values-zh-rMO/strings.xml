    <string name="patch_sigbypass">伪装术</string>
     <string name="patch_sigbypasslv0">乖乖睡觉 (None)</string>
    <string name="patch_sigbypasslv0_desc">啥也不干，当一只老实猫喵</string>
    <string name="patch_sigbypasslv1">瞒过 PM 警卫 (Basic)</string>
    <string name="patch_sigbypasslv1_desc">增加 Java IO 與 Native openat/openat64 重定向，讓簽名相關的檔案讀取改為存取原始 APK</string>
    <string name="patch_sigbypasslv2">深度幻术 (High)</string>
    <string name="patch_sigbypasslv2_desc">基於 Basic，恢復原始 AppComponentFactory，並 hook getPackageArchiveInfo 與 hasSigningCertificate 等更嚴格的校驗路徑</string>
    <string name="patch_sigbypasslv3">终极变脸 (Extreme)</string>
    <string name="patch_sigbypasslv3_desc">基於 High，hook PackageInfo(Parcel) 構造函數，覆蓋 Binder 反序列化取得簽名資訊的路徑</string>
    <string name="patch_override_version_code">改写喵龄</string>
    <string name="patch_override_version_code_desc">把喵龄改成自定义值，默认 1。这样更多时候都能强行塞回去，App通常察觉不到喵。</string>
    <string name="patch_custom_version_code">自定义喵龄</string>
    <string name="patch_new_package">改名卡喵</string>
    <string name="patch_inject_mt_provider">注入猫洞（MT Provider）</string>
    <string name="patch_inject_mt_provider_desc">挖个暗道，不用超级权限也能翻动 data 目录里的东西喵。</string>
    <string name="patch_use_microg">强喂 MicroG 小药水</string>
    <string name="patch_use_microg_desc">將 GMS 請求重新導向社群版 MicroG（例如 ReVanced GmsCore）。適用於 YouTube 等 Google 應用程式，需自行安裝對應的 MicroG 服務。</string>
    <string name="patch_output_log_to_media">把小秘密丢进 Media 目录</string>
    <string name="patch_output_log_to_media_desc">把 Xposed 和框架启动的日志全都写在 Media 文件夹里喵。</string>
