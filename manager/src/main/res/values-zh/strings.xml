    <string name="patch_mode">打包模式</string>
    <string name="patch_local">本地模式</string>
    <string name="patch_local_short">本地</string>
    <string name="patch_local_desc">为未嵌入模块的应用程序打补丁。\nXposed 范围可动态更改，无需重新打补丁。\n此模式下的应用程式只能在本地设备上与 ShimmerPatch 管理器搭配使用。</string>
    <string name="patch_integrated">集成模式</string>
    <string name="patch_integrated_desc">修补 App 并内置模块。\n经修补的应用可以在没有管理器的情况下独立运行，但不能动态管理配置。\n此模式适用于需要在未安装 ShimmerPatch 管理器的设备上运行的应用程式。</string>
    <string name="patch_embed_modules">嵌入模块</string>
    <string name="patch_advanced">进阶选项</string>
    <string name="patch_debuggable">可调试</string>
    <string name="patch_sigbypass">破解签名校验</string>
    <string name="patch_sigbypasslv0">None</string>
    <string name="patch_sigbypasslv0_desc">不进行任何处理</string>
    <string name="patch_sigbypasslv1">Basic</string>
    <string name="patch_sigbypasslv1_desc">增加 Java IO 与 Native openat/openat64 重定向，让签名相关的文件读取改为访问原始 APK</string>
    <string name="patch_sigbypasslv2">High</string>
    <string name="patch_sigbypasslv2_desc">基于 Basic，恢复原始 AppComponentFactory，并 hook getPackageArchiveInfo 与 hasSigningCertificate 等更严格的校验路径</string>
    <string name="patch_sigbypasslv3">Extreme</string>
    <string name="patch_sigbypasslv3_desc">基于 High，hook PackageInfo(Parcel) 构造函数，覆盖 Binder 反序列化得到签名信息的路径</string>
    <string name="patch_override_version_code">覆写版本号</string>
    <string name="patch_override_version_code_desc">将修补的 App 版本号重写为自定义值，默认为 1\n这将允许更多场景下的降级安装，并且通常来说这不会影响应用实际感知到的版本号</string>
    <string name="patch_custom_version_code">自定义版本号</string>
    <string name="patch_override_target_sdk">覆写 targetSdk</string>
    <string name="patch_override_target_sdk_desc">将修补的 App 的 targetSdk 版本重写为自定义值，默认为 28\n这可以提升部分依赖旧版 Android 行为特征的 Xposed 模块的兼容性</string>
    <string name="patch_custom_target_sdk">自定义 targetSdk</string>
    <string name="patch_new_package">修补新包名</string>
    <string name="patch_inject_mt_provider">注入文件提供器</string>
    <string name="patch_inject_mt_provider_desc">注入文件提供器以在没有 Root 权限的情况下管理 data 目录的文件 (来自 MT 管理器)</string>
    <string name="patch_use_microg">强制启用 MicroG 支持</string>
    <string name="patch_use_microg_desc">将 GMS 请求重定向至社区版 MicroG（例如 ReVanced GmsCore）。适用于 YouTube 等 Google 应用，需自行安装对应的 MicroG 服务。</string>
    <string name="patch_output_log_to_media">输出日志到 Media 目录</string>
    <string name="patch_output_log_to_media_desc">记录 Xposed API 日志、框架事件及 Java/Kotlin 崩溃</string>
    <string name="patch_inject_dex">注入加载器 DEX</string>
    <string name="patch_inject_dex_desc">将 加载器 DEX 物理写入主 DEX 序列。仅当装载的模块明确需要 Hook 独立子进程/沙箱组件时开启此特例选项。</string>
    <string name="patch_cleartext_traffic">允许 HTTP 明文流量</string>
    <string name="patch_cleartext_traffic_desc">在清单中强制设置 android:usesCleartextTraffic=\"true\"，允许应用与模块访问未加密的 HTTP 端点，以便进行流量检查、代理或调试。</string>
    <plurals name="patch_subprocess_detected_hint">
        <item quantity="other">检测到目标应用包含 %1$d 个独立子进程/沙箱组件。若模块需要 Hook 这些子进程，建议开启「注入加载器 DEX」。</item>
    </plurals>
