    <string name="patch_mode">修补模式</string>
    <string name="patch_local">本地模式</string>
    <string name="patch_local_desc">為未嵌入模組的應用程式打補丁。\nXposed 範圍可動態更改，無需重新打補丁。\n此模式下的應用程式只能在本地裝置上與 ShimmerPatch 管理器搭配使用。</string>
    <string name="patch_integrated">集成模式</string>
    <string name="patch_integrated_desc">修补 App 并内置模組。\n经修补的應用程式可以在没有管理器的情况下运行，但不能动态管理配置。\n以集成模式修补的應用程式可在未安裝 ShimmerPatch 管理器的裝置上运行。</string>
    <string name="patch_embed_modules">嵌入模組</string>
    <string name="patch_debuggable">可调试</string>
    <string name="patch_sigbypass">破解簽名校验</string>
    <string name="patch_sigbypasslv0">lv0: 關閉</string>
    <string name="patch_sigbypasslv1">lv1: 绕过 PM</string>
    <string name="patch_sigbypasslv2">lv2: 绕过 PM + openat (libc)</string>
    <string name="patch_override_version_code">覆写版本号</string>
    <string name="patch_override_version_code_desc">將修補的 App 版本號重寫為自訂值，預設為 1\n這將允許更多場景下的降級安裝，並且通常來說這不會影響應用程式實際感知到的版本號</string>
    <string name="patch_custom_version_code">自訂版本號</string>
    <string name="patch_override_target_sdk">覆寫 targetSdk</string>
    <string name="patch_override_target_sdk_desc">將修補的 App 的 targetSdk 版本重寫為自訂值，預設為 28\n這可以提升部分依賴舊版 Android 行為特徵的 Xposed 模組的相容性</string>
    <string name="patch_custom_target_sdk">自訂 targetSdk</string>
    <string name="patch_cleartext_traffic">允許 HTTP 明文流量</string>
    <string name="patch_cleartext_traffic_desc">在清單中強制設定 android:usesCleartextTraffic=\"true\"，允許應用程式與模組存取未加密的 HTTP 端點，以便進行流量檢查、代理或除錯。</string>
